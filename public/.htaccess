# Hostinger Apache — API reverse path + prerendered pages + SPA fallback
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- Orbit API (orbit-api deployed under /php) ---
  # /api/*  → php/public/index.php (keeps original REQUEST_URI for the router)
  RewriteRule ^api(?:/|$) php/public/index.php [L,QSA]

  # Uploaded media served from API uploads folder
  RewriteRule ^uploads/(.*)$ php/public/uploads/$1 [L]

  # Serve existing files and folders (includes /view-all/index.html)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Unknown paths → SPA shell; Angular router resolves the page
  RewriteRule ^ index.html [L]
</IfModule>

# Always serve live site content (editable after deploy without rebuild)
<IfModule mod_headers.c>
  <FilesMatch "site-content\.json$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
  </FilesMatch>
</IfModule>
