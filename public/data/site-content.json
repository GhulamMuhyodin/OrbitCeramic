  "pageCopy": {
    "hero": {
      "image": "/images/hero/hero-01.jpg",
      "brand": "Orbit Ceramic",
      "brandPrimary": "Orbit",
      "brandSecondary": "Ceramic",
      "title": "Handmade forms for everyday ritual",
      "lede": "Stone-fired vessels shaped slowly — cups, bowls, and tableware with a loft-born quiet.",
      "ctaLabel": "See Batch-002",
      "ctaHref": "/batch"
    },
    "about": {
      "eyebrow": "The maker",
      "heading": "Mr. Ghulam Jilani",
      "paragraphs": [
        "I am a ceramic artist and clay craftsman with a deep passion for transforming raw clay into timeless works of art. My work is inspired by traditional pottery, antique forms, natural textures, and the quiet beauty found in handmade objects. Every piece I create is shaped by hand, allowing each bowl, vase, platter, mug, and decorative sculpture to carry its own unique character and story.",
        "I specialize in handcrafted ceramic bowls, antique-inspired pottery, decorative clay art, custom ceramic pieces, and artisan home décor. My goal is to create heirloom-quality ceramics that celebrate the beauty of imperfection, the richness of traditional craftsmanship, and the lasting connection between the artist, the material, and the people who use my work."
      ],
      "image": "/images/about/about-01.jpg",
      "imageAlt": "Handmade ceramic vessels arranged in a loft studio"
    },
