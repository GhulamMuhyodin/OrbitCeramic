# Hostinger Apache — prerendered pages + SPA deep-link fallback
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve existing files and folders (includes /view-all/index.html)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Unknown paths → SPA shell; Angular router resolves the page
  RewriteRule ^ index.html [L]
</IfModule>

# Always serve live site content (editable after deploy without rebuild)
<IfModule mod_headers.c>
  <FilesMatch "site-content\.json$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
  </FilesMatch>
</IfModule>
